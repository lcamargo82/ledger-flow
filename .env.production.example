# LedgerFlow production env checklist for /home/camargo/apps/ledger-flow/.env
# Copy this file manually on the server and replace every secret before running Jenkins.
# Jenkins must not copy or generate the real .env.

NODE_ENV=production
TZ=America/Sao_Paulo
APP_NAME=LedgerFlow

APP_URL=https://ledgerflow.lcamargo.dev.br
API_URL=https://api-ledgerflow.lcamargo.dev.br
WEB_URL=https://ledgerflow.lcamargo.dev.br

API_HOST=0.0.0.0
API_PORT=3000
HOST_API_PORT=3010

WEB_HOST=0.0.0.0
WEB_PORT=80
HOST_WEB_PORT=5180

VITE_APP_NAME=LedgerFlow
VITE_APP_ENV=production
VITE_API_BASE_URL=https://api-ledgerflow.lcamargo.dev.br
VITE_WS_BASE_URL=wss://api-ledgerflow.lcamargo.dev.br
VITE_DEFAULT_LOCALE=pt-BR
VITE_DEFAULT_TIMEZONE=America/Sao_Paulo

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLIC_PORT=55432
POSTGRES_DB=ledgerflow
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://ledgerflow:CHANGE_ME@postgres:5432/ledgerflow?schema=public

MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_PUBLIC_PORT=27018
MONGODB_DATABASE=ledgerflow
MONGODB_USERNAME=ledgerflow
MONGODB_PASSWORD=CHANGE_ME
MONGODB_URL=mongodb://ledgerflow:CHANGE_ME@mongodb:27017/ledgerflow?authSource=admin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLIC_PORT=6380
REDIS_URL=redis://redis:6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PUBLIC_AMQP_PORT=5682
RABBITMQ_PUBLIC_MANAGEMENT_PORT=15682
RABBITMQ_DEFAULT_USER=ledgerflow
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_URL=amqp://ledgerflow:CHANGE_ME@rabbitmq:5672
RABBITMQ_PREFETCH=10

MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_NAME=LedgerFlow
SMTP_FROM_EMAIL=no-reply@ledgerflow.lcamargo.dev.br

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

ENCRYPTION_KEY=CHANGE_ME_32_BYTES_MINIMUM
GATEWAY_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY

CORS_ORIGIN=https://ledgerflow.lcamargo.dev.br
CORS_CREDENTIALS=true

SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
REDOC_ENABLED=true
REDOC_PATH=api/reference

PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9464
PROMETHEUS_PORT_PUBLIC=9091
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

DATADOG_ENABLED=false

# Mercado Livre application-level OAuth settings.
# Tenant/store tokens are created by OAuth and encrypted in the database, never in this file.
MERCADO_LIVRE_CLIENT_ID=CHANGE_ME
MERCADO_LIVRE_CLIENT_SECRET=CHANGE_ME
MERCADO_LIVRE_OAUTH_BASE_URL=https://auth.mercadolivre.com.br
MERCADO_LIVRE_API_BASE_URL=https://api.mercadolibre.com
MERCADO_LIVRE_CALLBACK_BASE_URL=https://api-ledgerflow.lcamargo.dev.br
