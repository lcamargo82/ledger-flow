model ReconciliationCase {
  id                    String                   @id @default(uuid())
  tenantId              String                   @map("tenant_id")
  provider              WebhookProvider
  status                ReconciliationCaseStatus @default(PENDING)
  matchType             ReconciliationMatchType  @default(NONE) @map("match_type")
  settlementEventId     String                   @map("settlement_event_id")
  paymentId             String?                  @map("payment_id")
  orderId               String?                  @map("order_id")
  expectedAmountMinor   Decimal?                 @map("expected_amount_minor") @db.Decimal(18, 0)
  receivedAmountMinor   Decimal?                 @map("received_amount_minor") @db.Decimal(18, 0)
  differenceAmountMinor Decimal?                 @map("difference_amount_minor") @db.Decimal(18, 0)
  currency              String                   @default("BRL")
  currencyExponent      Int                      @default(2) @map("currency_exponent")
  policyVersion         Int                      @default(1) @map("policy_version")
  matchedAt             DateTime?                @map("matched_at")
  reconciledAt          DateTime?                @map("reconciled_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlementEvent ProviderSettlementEvent  @relation(fields: [settlementEventId], references: [id], onDelete: Restrict)
