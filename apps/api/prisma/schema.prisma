  providerSettlementId      String?         @map("provider_settlement_id")
  providerPaymentId         String?         @map("provider_payment_id")
  externalReference         String?         @map("external_reference")
  eventType                 String          @map("event_type")
  providerStatus            String?         @map("provider_status")
  amountMinor               Decimal?        @map("amount_minor") @db.Decimal(18, 0)
  feeAmountMinor            Decimal?        @map("fee_amount_minor") @db.Decimal(18, 0)
  netAmountMinor            Decimal?        @map("net_amount_minor") @db.Decimal(18, 0)
