generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantKind {
  PLATFORM
  CUSTOMER
}

enum TenantInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PermissionScope {
  TENANT
  PLATFORM
}

enum ProductType {
  SIMPLE
  PARENT
  VARIANT
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVATION
  RESERVATION_RELEASE
  FULFILLMENT
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum InternalOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  FULFILLED
}

enum ChannelProvider {
  MOCK
  MERCADO_LIVRE
}

enum ChannelIntegrationStatus {
  INACTIVE
  ACTIVE
  DISABLED
  SUSPENDED
  REAUTH_REQUIRED
}

enum ChannelWebhookStatus {
  RECEIVED
  DUPLICATE
  INVALID
  DLQ
}

enum ChannelListingMatchStatus {
  MATCHED
  UNMATCHED
  AMBIGUOUS
  IGNORED
}

enum ChannelInventorySyncStatus {
  PENDING
  SYNCED
  RETRY_SCHEDULED
  CIRCUIT_OPEN
  FAILED
}

enum ChannelCircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

enum NotificationCategory {
  PAYMENTS
  INVENTORY
  CHANNELS
  ORDERS
  RECONCILIATION
  SYSTEM
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationWebhookSubscriptionStatus {
  ACTIVE
  DISABLED
}

enum NotificationWebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRY_SCHEDULED
  DLQ
  CANCELED
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  kind      TenantKind @default(CUSTOMER)
  timezone  String     @default("America/Sao_Paulo")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users                            User[]
  roles                            Role[]
  subscription                     TenantSubscription?
  authAttempts                     AuthAttempt[]
  customers                        Customer[]
  payments                         Payment[]
  paymentEvents                    PaymentEvent[]
  gatewayConfigurations            GatewayConfiguration[]
  gatewayReferences                GatewayCustomerReference[]
  webhookInboxEvents               WebhookInboxEvent[]
  adminInvitations                 TenantAdminInvitation[]
  outboxEvents                     OutboxEvent[]
  asyncJobExecutions               AsyncJobExecution[]
  products                         Product[]
  productSkus                      ProductSku[]
  warehouses                       Warehouse[]
  inventoryMovements               InventoryMovement[]
  inventoryBalances                InventoryBalance[]
  inventoryReservations            InventoryReservation[]
  internalOrders                   InternalOrder[]
  internalOrderItems               InternalOrderItem[]
  orderFinancialFacts              OrderFinancialFact[]
  exportJobs                       ExportJob[]
  channelIntegrations              ChannelIntegration[]
  channelWebhookEvents             ChannelWebhookInboxEvent[]
  channelListings                  ChannelListing[]
  listingSkuMappings               ListingSkuMapping[]
  channelInventorySyncs            ChannelInventorySyncState[]
  providerSettlementEvents         ProviderSettlementEvent[]
  reconciliationCases              ReconciliationCase[]
  reconciliationPolicies           ReconciliationPolicy[]
  reconciliationDecisions          ReconciliationDecision[]
  notificationEvents               NotificationEvent[]
  notificationRecipients           NotificationRecipient[]
  notificationWebhookSubscriptions NotificationWebhookSubscription[]
  notificationWebhookDeliveries    NotificationWebhookDelivery[]

  @@map("tenants")
}

model User {
  id                  String    @id @default(uuid())
  tenantId            String
  name                String
  email               String
  passwordHash        String
  isPlatformAdmin     Boolean   @default(false)
  active              Boolean   @default(true)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant                                  Tenant                            @relation(fields: [tenantId], references: [id])
  roles                                   UserRole[]
  refreshTokens                           RefreshToken[]
  sessions                                UserSession[]
  passwordResetTokens                     PasswordResetToken[]
  tenantAdminInvitations                  TenantAdminInvitation[]
  reconciliationDecisions                 ReconciliationDecision[]
  notificationRecipients                  NotificationRecipient[]
  createdNotificationWebhookSubscriptions NotificationWebhookSubscription[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model NotificationEvent {
  id                   String               @id @default(uuid())
  tenantId             String
  category             NotificationCategory
  eventType            String
  severity             NotificationSeverity @default(INFO)
  titleKey             String
  messageKey           String
  translationArgsJson  Json?                @map("translation_args_json")
  metadataJson         Json?                @map("metadata_json")
  sourceType           String
  sourceId             String?
  idempotencyKey       String
  requiredPermissions  String[]             @default([])
  requiredCapabilities String[]             @default([])
  occurredAt           DateTime
  createdAt            DateTime             @default(now())

  tenant            Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients        NotificationRecipient[]
  webhookDeliveries NotificationWebhookDelivery[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, category, createdAt(sort: Desc)])
  @@index([tenantId, sourceType, sourceId])
  @@map("notification_events")
}

model NotificationRecipient {
  id                  String    @id @default(uuid())
  tenantId            String
  notificationEventId String
  userId              String
  readAt              DateTime?
  dismissedAt         DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notificationEvent NotificationEvent @relation(fields: [notificationEventId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationEventId, userId])
  @@index([tenantId, userId, readAt, createdAt(sort: Desc)])
  @@index([tenantId, userId, dismissedAt, createdAt(sort: Desc)])
  @@map("notification_recipients")
}

model NotificationWebhookSubscription {
  id                  String                                @id @default(uuid())
  tenantId            String
  name                String
  endpointUrl         String
  status              NotificationWebhookSubscriptionStatus @default(ACTIVE)
  eventTypes          String[]                              @default([])
  encryptedSecretJson Json                                  @map("encrypted_secret_json")
  secretFingerprint   String                                @map("secret_fingerprint")
  createdByUserId     String                                @map("created_by_user_id")
  createdAt           DateTime                              @default(now())
  updatedAt           DateTime                              @updatedAt

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser User                          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveries    NotificationWebhookDelivery[]

  @@unique([tenantId, endpointUrl])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("notification_webhook_subscriptions")
}

model NotificationWebhookDelivery {
  id                  String                            @id @default(uuid())
  tenantId            String
  subscriptionId      String                            @map("subscription_id")
  notificationEventId String                            @map("notification_event_id")
  status              NotificationWebhookDeliveryStatus @default(PENDING)
  idempotencyKey      String                            @map("idempotency_key")
  attemptCount        Int                               @default(0) @map("attempt_count")
  maxAttempts         Int                               @default(8) @map("max_attempts")
  nextAttemptAt       DateTime?                         @map("next_attempt_at")
  lastAttemptAt       DateTime?                         @map("last_attempt_at")
  deliveredAt         DateTime?                         @map("delivered_at")
  responseStatusCode  Int?                              @map("response_status_code")
  errorCode           String?                           @map("error_code")
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  tenant            Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription      NotificationWebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  notificationEvent NotificationEvent               @relation(fields: [notificationEventId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@unique([subscriptionId, notificationEventId])
  @@index([tenantId, status, nextAttemptAt, createdAt])
  @@index([subscriptionId, status, createdAt(sort: Desc)])
  @@map("notification_webhook_deliveries")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  key         String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String          @id @default(uuid())
  key         String          @unique
  description String?
  scope       PermissionScope @default(TENANT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session UserSession?

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id              String    @id @default(uuid())
  userId          String
  refreshTokenId  String?   @unique
  ipAddress       String?
  userAgent       String?
  deviceName      String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  active          Boolean   @default(true)
  revokedAt       DateTime?
  expiresAt       DateTime
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([refreshTokenId])
  @@index([active])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuthAttempt {
  id            String   @id @default(uuid())
  tenantId      String?
  email         String
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email])
  @@index([ipAddress])
  @@index([success])
  @@index([createdAt])
  @@map("auth_attempts")
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Customer {
  id        String       @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  document  String?
  phone     String?
  type      CustomerType @default(INDIVIDUAL)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments          Payment[]
  gatewayReferences GatewayCustomerReference[]

  @@unique([tenantId, email])
  @@unique([tenantId, document])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
  @@index([tenantId, email])
  @@index([tenantId, document])
  @@map("customers")
}

model Product {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  type            ProductType
  status          ProductStatus @default(ACTIVE)
  parentProductId String?       @map("parent_product_id")
  name            String
  description     String?
  brand           String?
  category        String?
  attributes      Json?         @map("attributes_json")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  archivedAt      DateTime?     @map("archived_at")

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentProduct Product?    @relation("ProductHierarchy", fields: [parentProductId], references: [id], onDelete: Restrict)
  childProducts Product[]   @relation("ProductHierarchy")
  sku           ProductSku?

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, parentProductId])
  @@index([tenantId, name])
  @@map("products")
}

model ProductSku {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  productId     String   @unique @map("product_id")
  skuCanonical  String   @map("sku_canonical")
  skuDisplay    String   @map("sku_display")
  barcode       String?
  unitOfMeasure String   @default("UN") @map("unit_of_measure")
  costPolicy    String   @default("WEIGHTED_AVERAGE") @map("cost_policy")
  averageCost   Decimal  @map("average_cost") @db.Decimal(18, 4)
  currency      String   @default("BRL")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryMovements    InventoryMovement[]
  inventoryBalances     InventoryBalance[]
  inventoryReservations InventoryReservation[]
  internalOrderItems    InternalOrderItem[]
  channelListings       ChannelListing[]
  listingSkuMappings    ListingSkuMapping[]

  @@unique([tenantId, skuCanonical])
  @@index([tenantId, barcode])
  @@map("product_skus")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryMovements    InventoryMovement[]
  inventoryBalances     InventoryBalance[]
  inventoryReservations InventoryReservation[]
  internalOrderItems    InternalOrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("warehouses")
}

model InventoryMovement {
  id              String                @id @default(uuid())
  tenantId        String                @map("tenant_id")
  skuId           String                @map("sku_id")
  warehouseId     String                @map("warehouse_id")
  type            InventoryMovementType
  quantityDelta   Decimal               @map("quantity_delta") @db.Decimal(18, 6)
  unitCost        Decimal?              @map("unit_cost") @db.Decimal(18, 4)
  sourceType      String                @map("source_type")
  sourceId        String                @map("source_id")
  idempotencyKey  String                @map("idempotency_key")
  reasonCode      String?               @map("reason_code")
  notes           String?
  occurredAt      DateTime              @map("occurred_at")
  createdByUserId String?               @map("created_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, skuId, warehouseId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, occurredAt])
  @@map("inventory_movements")
}

model InventoryBalance {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  skuId             String   @map("sku_id")
  warehouseId       String   @map("warehouse_id")
  onHandQuantity    Decimal  @map("on_hand_quantity") @db.Decimal(18, 6)
  reservedQuantity  Decimal  @default(0) @map("reserved_quantity") @db.Decimal(18, 6)
  availableQuantity Decimal  @map("available_quantity") @db.Decimal(18, 6)
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, skuId, warehouseId])
  @@index([tenantId, skuId])
  @@index([tenantId, warehouseId])
  @@map("inventory_balances")
}

model InventoryReservation {
  id              String                     @id @default(uuid())
  tenantId        String                     @map("tenant_id")
  skuId           String                     @map("sku_id")
  warehouseId     String                     @map("warehouse_id")
  quantity        Decimal                    @db.Decimal(18, 6)
  status          InventoryReservationStatus @default(ACTIVE)
  sourceType      String                     @map("source_type")
  sourceId        String                     @map("source_id")
  idempotencyKey  String                     @map("idempotency_key")
  reasonCode      String                     @map("reason_code")
  notes           String?
  createdByUserId String?                    @map("created_by_user_id")
  releasedAt      DateTime?                  @map("released_at")
  consumedAt      DateTime?                  @map("consumed_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku       ProductSku         @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  orderItem InternalOrderItem?

  @@unique([tenantId, sourceType, sourceId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, skuId, warehouseId, status])
  @@index([tenantId, status])
  @@map("inventory_reservations")
}

model InternalOrder {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  orderNumber     String              @map("order_number")
  status          InternalOrderStatus @default(DRAFT)
  idempotencyKey  String              @map("idempotency_key")
  customerName    String?             @map("customer_name")
  notes           String?
  confirmedAt     DateTime?           @map("confirmed_at")
  cancelledAt     DateTime?           @map("cancelled_at")
  fulfilledAt     DateTime?           @map("fulfilled_at")
  createdByUserId String?             @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items          InternalOrderItem[]
  financialFacts OrderFinancialFact[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("internal_orders")
}

model InternalOrderItem {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  orderId       String   @map("order_id")
  skuId         String   @map("sku_id")
  warehouseId   String   @map("warehouse_id")
  quantity      Decimal  @db.Decimal(18, 6)
  reservationId String?  @unique @map("reservation_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order       InternalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku         ProductSku            @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reservation InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([tenantId, orderId])
  @@index([tenantId, skuId])
  @@index([tenantId, warehouseId])
  @@map("internal_order_items")
}

model OrderFinancialFact {
  id                String              @id @default(uuid())
  tenantId          String              @map("tenant_id")
  orderId           String              @map("order_id")
  version           Int                 @default(1)
  orderNumber       String              @map("order_number")
  orderStatus       InternalOrderStatus @map("order_status")
  channelProvider   ChannelProvider?    @map("channel_provider")
  revenueAmount     Decimal             @default(0) @map("revenue_amount") @db.Decimal(18, 4)
  cogsAmount        Decimal             @default(0) @map("cogs_amount") @db.Decimal(18, 4)
  channelFeeAmount  Decimal             @default(0) @map("channel_fee_amount") @db.Decimal(18, 4)
  grossMarginAmount Decimal             @default(0) @map("gross_margin_amount") @db.Decimal(18, 4)
  currency          String              @default("BRL")
  itemCount         Int                 @default(0) @map("item_count")
  fulfilledAt       DateTime?           @map("fulfilled_at")
  calculatedAt      DateTime            @default(now()) @map("calculated_at")
  components        Json                @map("components_json")
  createdAt         DateTime            @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  InternalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderId, version])
  @@index([tenantId, calculatedAt])
  @@index([tenantId, channelProvider, calculatedAt])
  @@index([tenantId, orderStatus])
  @@map("order_financial_facts")
}

model ChannelIntegration {
  id                        String                   @id @default(uuid())
  tenantId                  String                   @map("tenant_id")
  provider                  ChannelProvider
  name                      String
  externalAccountId         String?                  @map("external_account_id")
  externalStoreId           String?                  @map("external_store_id")
  displayName               String?                  @map("display_name")
  status                    ChannelIntegrationStatus @default(INACTIVE)
  webhookSecretHash         String?                  @map("webhook_secret_hash")
  encryptedCredentials      Json?                    @map("encrypted_credentials")
  credentialsVersion        Int                      @default(0) @map("credentials_version")
  credentialsFingerprint    String?                  @map("credentials_fingerprint")
  settingsJson              Json?                    @map("settings_json")
  defaultWarehouseId        String?                  @map("default_warehouse_id")
  syncPolicyJson            Json?                    @map("sync_policy_json")
  healthStatus              String?                  @map("health_status")
  lastSuccessfulOperationAt DateTime?                @map("last_successful_operation_at")
  lastFailureAt             DateTime?                @map("last_failure_at")
  createdByUserId           String?                  @map("created_by_user_id")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookEvents ChannelWebhookInboxEvent[]
  listings      ChannelListing[]

  @@unique([tenantId, provider, name])
  @@unique([tenantId, provider, externalAccountId])
  @@index([tenantId, provider, status])
  @@index([tenantId, provider, externalStoreId])
  @@index([provider, webhookSecretHash])
  @@map("channel_integrations")
}

model ChannelWebhookInboxEvent {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  integrationId   String               @map("integration_id")
  provider        ChannelProvider
  providerEventId String               @map("provider_event_id")
