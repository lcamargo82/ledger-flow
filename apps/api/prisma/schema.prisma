generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantKind {
  PLATFORM
  CUSTOMER
}

enum TenantInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PermissionScope {
  TENANT
  PLATFORM
}

enum ProductType {
  SIMPLE
  PARENT
  VARIANT
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVATION
  RESERVATION_RELEASE
  FULFILLMENT
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum InternalOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  FULFILLED
}

enum ChannelProvider {
  MOCK
  MERCADO_LIVRE
}

enum ChannelIntegrationStatus {
  ACTIVE
  DISABLED
}

enum ChannelWebhookStatus {
  RECEIVED
  DUPLICATE
  INVALID
  DLQ
}

enum ChannelListingMatchStatus {
  MATCHED
  UNMATCHED
  AMBIGUOUS
  IGNORED
}

enum ChannelInventorySyncStatus {
  PENDING
  SYNCED
  RETRY_SCHEDULED
  CIRCUIT_OPEN
  FAILED
}

enum ChannelCircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  kind      TenantKind @default(CUSTOMER)
  timezone  String     @default("America/Sao_Paulo")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users                 User[]
  roles                 Role[]
  subscription          TenantSubscription?
  authAttempts          AuthAttempt[]
  customers             Customer[]
  payments              Payment[]
  paymentEvents         PaymentEvent[]
  gatewayConfigurations GatewayConfiguration[]
  gatewayReferences     GatewayCustomerReference[]
  webhookInboxEvents    WebhookInboxEvent[]
  adminInvitations      TenantAdminInvitation[]
  outboxEvents          OutboxEvent[]
  asyncJobExecutions    AsyncJobExecution[]
  products              Product[]
  productSkus           ProductSku[]
  warehouses            Warehouse[]
  inventoryMovements    InventoryMovement[]
  inventoryBalances     InventoryBalance[]
  inventoryReservations InventoryReservation[]
  internalOrders        InternalOrder[]
  internalOrderItems    InternalOrderItem[]
  orderFinancialFacts   OrderFinancialFact[]
  channelIntegrations   ChannelIntegration[]
  channelWebhookEvents  ChannelWebhookInboxEvent[]
  channelListings       ChannelListing[]
  listingSkuMappings    ListingSkuMapping[]
  channelInventorySyncs ChannelInventorySyncState[]

  @@map("tenants")
}

model User {
  id                  String    @id @default(uuid())
  tenantId            String
  name                String
  email               String
  passwordHash        String
  isPlatformAdmin     Boolean   @default(false)
  active              Boolean   @default(true)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  sessions               UserSession[]
  passwordResetTokens    PasswordResetToken[]
  tenantAdminInvitations TenantAdminInvitation[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  key         String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String          @id @default(uuid())
  key         String          @unique
  description String?
  scope       PermissionScope @default(TENANT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session UserSession?

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id              String    @id @default(uuid())
  userId          String
  refreshTokenId  String?   @unique
  ipAddress       String?
  userAgent       String?
  deviceName      String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  active          Boolean   @default(true)
  revokedAt       DateTime?
  expiresAt       DateTime
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([refreshTokenId])
  @@index([active])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuthAttempt {
  id            String   @id @default(uuid())
  tenantId      String?
  email         String
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email])
  @@index([ipAddress])
  @@index([success])
  @@index([createdAt])
  @@map("auth_attempts")
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Customer {
  id        String       @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  document  String?
  phone     String?
  type      CustomerType @default(INDIVIDUAL)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments          Payment[]
  gatewayReferences GatewayCustomerReference[]

  @@unique([tenantId, email])
  @@unique([tenantId, document])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
  @@index([tenantId, email])
  @@index([tenantId, document])
  @@map("customers")
}

model Product {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  type            ProductType
  status          ProductStatus @default(ACTIVE)
  parentProductId String?       @map("parent_product_id")
  name            String
  description     String?
  brand           String?
  category        String?
  attributes      Json?         @map("attributes_json")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  archivedAt      DateTime?     @map("archived_at")

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentProduct Product?    @relation("ProductHierarchy", fields: [parentProductId], references: [id], onDelete: Restrict)
  childProducts Product[]   @relation("ProductHierarchy")
  sku           ProductSku?

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, parentProductId])
  @@index([tenantId, name])
  @@map("products")
}

model ProductSku {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  productId     String   @unique @map("product_id")
  skuCanonical  String   @map("sku_canonical")
  skuDisplay    String   @map("sku_display")
  barcode       String?
  unitOfMeasure String   @default("UN") @map("unit_of_measure")
  costPolicy    String   @default("WEIGHTED_AVERAGE") @map("cost_policy")
  averageCost   Decimal  @map("average_cost") @db.Decimal(18, 4)
  currency      String   @default("BRL")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryMovements    InventoryMovement[]
  inventoryBalances     InventoryBalance[]
  inventoryReservations InventoryReservation[]
  internalOrderItems    InternalOrderItem[]
  channelListings       ChannelListing[]
  listingSkuMappings    ListingSkuMapping[]

  @@unique([tenantId, skuCanonical])
  @@index([tenantId, barcode])
  @@map("product_skus")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryMovements    InventoryMovement[]
  inventoryBalances     InventoryBalance[]
  inventoryReservations InventoryReservation[]
  internalOrderItems    InternalOrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("warehouses")
}

model InventoryMovement {
  id              String                @id @default(uuid())
  tenantId        String                @map("tenant_id")
  skuId           String                @map("sku_id")
  warehouseId     String                @map("warehouse_id")
  type            InventoryMovementType
  quantityDelta   Decimal               @map("quantity_delta") @db.Decimal(18, 6)
  unitCost        Decimal?              @map("unit_cost") @db.Decimal(18, 4)
  sourceType      String                @map("source_type")
  sourceId        String                @map("source_id")
  idempotencyKey  String                @map("idempotency_key")
  reasonCode      String?               @map("reason_code")
  notes           String?
  occurredAt      DateTime              @map("occurred_at")
  createdByUserId String?               @map("created_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, skuId, warehouseId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, occurredAt])
  @@map("inventory_movements")
}

model InventoryBalance {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  skuId             String   @map("sku_id")
  warehouseId       String   @map("warehouse_id")
  onHandQuantity    Decimal  @map("on_hand_quantity") @db.Decimal(18, 6)
  reservedQuantity  Decimal  @default(0) @map("reserved_quantity") @db.Decimal(18, 6)
  availableQuantity Decimal  @map("available_quantity") @db.Decimal(18, 6)
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, skuId, warehouseId])
  @@index([tenantId, skuId])
  @@index([tenantId, warehouseId])
  @@map("inventory_balances")
}

model InventoryReservation {
  id              String                     @id @default(uuid())
  tenantId        String                     @map("tenant_id")
  skuId           String                     @map("sku_id")
  warehouseId     String                     @map("warehouse_id")
  quantity        Decimal                    @db.Decimal(18, 6)
  status          InventoryReservationStatus @default(ACTIVE)
  sourceType      String                     @map("source_type")
  sourceId        String                     @map("source_id")
  idempotencyKey  String                     @map("idempotency_key")
  reasonCode      String                     @map("reason_code")
  notes           String?
  createdByUserId String?                    @map("created_by_user_id")
  releasedAt      DateTime?                  @map("released_at")
  consumedAt      DateTime?                  @map("consumed_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku       ProductSku         @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  orderItem InternalOrderItem?

  @@unique([tenantId, sourceType, sourceId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, skuId, warehouseId, status])
  @@index([tenantId, status])
  @@map("inventory_reservations")
}

model InternalOrder {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  orderNumber     String              @map("order_number")
  status          InternalOrderStatus @default(DRAFT)
  idempotencyKey  String              @map("idempotency_key")
  customerName    String?             @map("customer_name")
  notes           String?
  confirmedAt     DateTime?           @map("confirmed_at")
  cancelledAt     DateTime?           @map("cancelled_at")
  fulfilledAt     DateTime?           @map("fulfilled_at")
  createdByUserId String?             @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  InternalOrderItem[]
  financialFacts OrderFinancialFact[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("internal_orders")
}

model InternalOrderItem {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  orderId       String   @map("order_id")
  skuId         String   @map("sku_id")
  warehouseId   String   @map("warehouse_id")
  quantity      Decimal  @db.Decimal(18, 6)
  reservationId String?  @unique @map("reservation_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order       InternalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku         ProductSku            @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reservation InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([tenantId, orderId])
  @@index([tenantId, skuId])
  @@index([tenantId, warehouseId])
  @@map("internal_order_items")
}

model OrderFinancialFact {
  id                String           @id @default(uuid())
  tenantId          String           @map("tenant_id")
  orderId           String           @map("order_id")
  version           Int              @default(1)
  orderNumber       String           @map("order_number")
  orderStatus       InternalOrderStatus @map("order_status")
  channelProvider   ChannelProvider? @map("channel_provider")
  revenueAmount     Decimal          @default(0) @map("revenue_amount") @db.Decimal(18, 4)
  cogsAmount        Decimal          @default(0) @map("cogs_amount") @db.Decimal(18, 4)
  channelFeeAmount  Decimal          @default(0) @map("channel_fee_amount") @db.Decimal(18, 4)
  grossMarginAmount Decimal          @default(0) @map("gross_margin_amount") @db.Decimal(18, 4)
  currency          String           @default("BRL")
  itemCount         Int              @default(0) @map("item_count")
  fulfilledAt       DateTime?        @map("fulfilled_at")
  calculatedAt      DateTime         @default(now()) @map("calculated_at")
  components        Json             @map("components_json")
  createdAt         DateTime         @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  InternalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderId, version])
  @@index([tenantId, calculatedAt])
  @@index([tenantId, channelProvider, calculatedAt])
  @@index([tenantId, orderStatus])
  @@map("order_financial_facts")
}

model ChannelIntegration {
  id                String                   @id @default(uuid())
  tenantId          String                   @map("tenant_id")
  provider          ChannelProvider
  name              String
  status            ChannelIntegrationStatus @default(ACTIVE)
  webhookSecretHash String                   @map("webhook_secret_hash")
  createdByUserId   String?                  @map("created_by_user_id")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookEvents ChannelWebhookInboxEvent[]
  listings      ChannelListing[]

  @@unique([tenantId, provider, name])
  @@index([tenantId, provider, status])
  @@index([provider, webhookSecretHash])
  @@map("channel_integrations")
}

model ChannelWebhookInboxEvent {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  integrationId   String               @map("integration_id")
  provider        ChannelProvider
  providerEventId String               @map("provider_event_id")
  eventType       String               @map("event_type")
  status          ChannelWebhookStatus @default(RECEIVED)
  payloadHash     String               @map("payload_hash")
  payloadSummary  Json?                @map("payload_summary")
  receivedAt      DateTime             @default(now()) @map("received_at")
  processedAt     DateTime?            @map("processed_at")
  failureReason   String?              @map("failure_reason")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([tenantId, status])
  @@index([tenantId, provider])
  @@index([integrationId])
  @@index([receivedAt])
  @@map("channel_webhook_inbox_events")
}

model ChannelListing {
  id                String                    @id @default(uuid())
  tenantId          String                    @map("tenant_id")
  integrationId     String                    @map("integration_id")
  provider          ChannelProvider
  externalListingId String                    @map("external_listing_id")
  title             String
  externalSku       String?                   @map("external_sku")
  matchStatus       ChannelListingMatchStatus @default(UNMATCHED) @map("match_status")
  matchedSkuId      String?                   @map("matched_sku_id")
  candidateSkuIds   Json?                     @map("candidate_sku_ids")
  importedAt        DateTime                  @default(now()) @map("imported_at")
  ignoredAt         DateTime?                 @map("ignored_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  matchedSku  ProductSku?        @relation(fields: [matchedSkuId], references: [id], onDelete: SetNull)
  mappings    ListingSkuMapping[]
  syncState   ChannelInventorySyncState?

  @@unique([tenantId, integrationId, externalListingId])
  @@index([tenantId, matchStatus])
  @@index([tenantId, integrationId])
  @@index([tenantId, externalSku])
  @@map("channel_listings")
}

model ListingSkuMapping {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  listingId      String   @map("listing_id")
  skuId          String   @map("sku_id")
  mappedByUserId String?  @map("mapped_by_user_id")
  reason         String?  @map("reason")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing ChannelListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sku     ProductSku     @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([tenantId, listingId])
  @@index([tenantId, skuId])
  @@map("listing_sku_mappings")
}

model ChannelInventorySyncState {
  id                      String                     @id @default(uuid())
  tenantId                String                     @map("tenant_id")
  listingId               String                     @unique @map("listing_id")
  integrationId           String                     @map("integration_id")
  provider                ChannelProvider
  externalListingId       String                     @map("external_listing_id")
  skuId                   String                     @map("sku_id")
  status                  ChannelInventorySyncStatus @default(PENDING)
  circuitState            ChannelCircuitState        @default(CLOSED) @map("circuit_state")
  targetAvailableQuantity Decimal                    @map("target_available_quantity") @db.Decimal(18, 6)
  lastSyncedQuantity      Decimal?                   @map("last_synced_quantity") @db.Decimal(18, 6)
  attemptCount            Int                        @default(0) @map("attempt_count")
  nextAttemptAt           DateTime?                  @map("next_attempt_at")
  circuitOpenedUntil      DateTime?                  @map("circuit_opened_until")
  lastErrorCode           String?                    @map("last_error_code")
  lastErrorSummary        String?                    @map("last_error_summary")
  lastRequestedAt         DateTime                   @default(now()) @map("last_requested_at")
  lastSyncedAt            DateTime?                  @map("last_synced_at")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing ChannelListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, provider])
  @@index([integrationId, status])
  @@index([nextAttemptAt])
  @@map("channel_inventory_sync_states")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
  @@map("password_reset_tokens")
}

model TenantAdminInvitation {
  id              String                 @id @default(uuid())
  tenantId        String
  userId          String
  email           String
  tokenHash       String                 @unique
  status          TenantInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("tenant_admin_invitations")
}

model AuditLog {
  id          String           @id @default(uuid())
  scope       PermissionScope?
  severity    AuditSeverity?
  tenantId    String?
  actorUserId String?
  actorType   AuditActorType?
  source      String?
  entityType  String?
  entityId    String?
  action      String
  summary     String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  traceId     String?
  createdAt   DateTime         @default(now())

  @@index([tenantId])
  @@index([action])
  @@index([severity])
  @@index([actorType])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
  WEBHOOK
  WORKER
}

enum PaymentProvider {
  STRIPE
  ASAAS
  MERCADO_PAGO
  PAGBANK
  PAGARME
}

enum GatewayEnvironment {
  SANDBOX
  TEST
  LIVE
}

enum GatewayConfigurationStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum GatewayHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
}

model GatewayConfiguration {
  id                     String                     @id @default(uuid())
  tenantId               String
  provider               PaymentProvider
  environment            GatewayEnvironment
  status                 GatewayConfigurationStatus @default(INACTIVE)
  priority               Int                        @default(100)
  displayName            String?
  supportedMethods       Json?
  encryptedCredentials   String?
  credentialsFingerprint String?
  healthStatus           GatewayHealthStatus        @default(UNKNOWN)
  lastHealthCheckAt      DateTime?
  lastHealthCheckMessage String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments           Payment[]
  gatewayReferences  GatewayCustomerReference[]
  webhookInboxEvents WebhookInboxEvent[]

  @@unique([tenantId, provider, environment])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, provider])
  @@index([tenantId, priority])
  @@index([provider, environment])
  @@map("gateway_configurations")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  PIX
  BOLETO
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentExecutionMode {
  EXTERNAL_GATEWAY
  MANUAL
  INTERNAL
}

model Payment {
  id                     String               @id @default(uuid())
  tenantId               String
  customerId             String
  reference              String
  externalReference      String?
  amount                 Int
  currency               String               @default("BRL")
  method                 PaymentMethod
  status                 PaymentStatus        @default(PENDING)
  executionMode          PaymentExecutionMode @default(EXTERNAL_GATEWAY)
  description            String?
  dueDate                DateTime?
  metadata               Json?
  idempotencyKeyHash     String
  idempotencyRequestHash String
  provider               PaymentProvider?
  providerPaymentId      String?
  providerStatus         String?
  providerUpdatedAt      DateTime?
  providerInvoiceUrl     String?
  providerBankSlipUrl    String?
  providerPixCopyPaste   String?
  providerPixExpiresAt   DateTime?
  providerPaymentUrl     String?
  gatewayConfigurationId String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  canceledAt             DateTime?
  refundedAt             DateTime?

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  gatewayConfiguration GatewayConfiguration? @relation(fields: [gatewayConfigurationId], references: [id], onDelete: SetNull)
  events               PaymentEvent[]
  webhookInboxEvents   WebhookInboxEvent[]

  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKeyHash])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@index([tenantId, reference])
  @@index([customerId])
  @@index([provider, providerPaymentId])
  @@index([gatewayConfigurationId])
  @@map("payments")
}

model PaymentEvent {
  id             String         @id @default(uuid())
  tenantId       String
  paymentId      String
  type           String
  previousStatus PaymentStatus?
  currentStatus  PaymentStatus?
  message        String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@index([type])
  @@index([createdAt])
  @@map("payment_events")
}

model GatewayCustomerReference {
  id                     String          @id @default(uuid())
  tenantId               String
  customerId             String
  gatewayConfigurationId String
  provider               PaymentProvider
  providerCustomerId     String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  gatewayConfiguration GatewayConfiguration @relation(fields: [gatewayConfigurationId], references: [id], onDelete: Cascade)

  @@unique([gatewayConfigurationId, customerId])
  @@unique([gatewayConfigurationId, providerCustomerId])
  @@index([tenantId])
  @@index([customerId])
  @@index([gatewayConfigurationId])
  @@index([provider, providerCustomerId])
  @@map("gateway_customer_references")
}

enum WebhookProvider {
  ASAAS
  STRIPE
  MERCADO_PAGO
  PAGBANK
  PAGARME
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
  UNMATCHED
  INVALID
}

model WebhookInboxEvent {
  id                     String                  @id @default(uuid())
  provider               WebhookProvider
  providerEventId        String
  eventType              String
  providerPaymentId      String?
  externalReference      String?
  providerPaymentStatus  String?
  tenantId               String?
  paymentId              String?
  gatewayConfigurationId String?
  status                 WebhookProcessingStatus @default(RECEIVED)
  payloadHash            String
  payloadSummary         Json?
  receivedAt             DateTime                @default(now())
  processedAt            DateTime?
  failedAt               DateTime?
  failureReason          String?
  attemptCount           Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  tenant               Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  payment              Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  gatewayConfiguration GatewayConfiguration? @relation(fields: [gatewayConfigurationId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([tenantId])
  @@index([paymentId])
  @@index([gatewayConfigurationId])
  @@index([receivedAt])
  @@index([providerPaymentId])
  @@index([externalReference])
  @@map("webhook_inbox_events")
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model TenantSubscription {
  id                            String                   @id @default(uuid())
  tenantId                      String                   @unique
  plan                          SubscriptionPlan         @default(FREE)
  status                        TenantSubscriptionStatus @default(TRIAL)
  trialEndsAt                   DateTime?
  currentPeriodStart            DateTime?
  currentPeriodEnd              DateTime?
  externalSubscriptionReference String?
  notes                         String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("tenant_subscriptions")
}

enum OutboxEventStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

enum AsyncJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRY_SCHEDULED
  DEAD_LETTERED
  FAILED
}

model OutboxEvent {
  id            String  @id @default(uuid())
  tenantId      String?
  aggregateType String
  aggregateId   String
  eventType     String
  eventVersion  Int     @default(1)

  payload     Json
  payloadHash String

  status          OutboxEventStatus @default(PENDING)
  publishAttempts Int               @default(0)
  availableAt     DateTime          @default(now())
  publishedAt     DateTime?
  lockedAt        DateTime?
  lockOwner       String?
  leaseExpiresAt  DateTime?

  lastErrorCode    String?
  lastErrorSummary String?

  traceId         String?
  replayOfEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([tenantId, createdAt])
  @@index([eventType, status])
  @@index([aggregateType, aggregateId])
  @@index([traceId])
  @@index([replayOfEventId])
  @@map("outbox_events")
}

model AsyncJobExecution {
  id            String  @id @default(uuid())
  outboxEventId String
  consumerName  String
  tenantId      String?

  status       AsyncJobStatus @default(PENDING)
  attemptCount Int            @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  nextRetryAt DateTime?

  lastErrorCode    String?
  lastErrorSummary String?

  traceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([outboxEventId, consumerName])
  @@index([status, nextRetryAt])
  @@index([tenantId, status])
  @@index([traceId])
  @@map("async_job_executions")
}
